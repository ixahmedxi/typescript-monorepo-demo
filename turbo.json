{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "//#codegen": {
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "scripts/**/*"],
      "outputs": ["generated-routers/**"]
    },
    "build": {
      "dependsOn": ["^build", "//#codegen"],
      "inputs": ["src/**/*", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "persistent": false
    }
  }
}
